    "commander": "^13.1.0",
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "chrome-remote-interface": "^0.28.2",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
