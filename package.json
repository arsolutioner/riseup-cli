{
  "name": "riseup-cli",
  "version": "0.1.0",
  "description": "Unofficial CLI for RiseUp personal finance (input.riseup.co.il)",
  "type": "module",
  "bin": {
    "riseup": "./dist/cli.js"
  },
  "files": [
